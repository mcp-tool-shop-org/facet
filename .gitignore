# Assets are large and regenerable — the pipeline is the deliverable, not its output.
*.glb
*.gltf
*.npy
*.blend
*.blend1
*.safetensors
*.pth

# Renders, atlases, contact sheets
*.png
*.jpg
*.jpeg
*.exr
!docs/**/*.png

# canon/ is the ONE exception, and it is the exception this file's own premise allows.
# "Large and regenerable" is measured FALSE for these two: rebuilt from the same clay,
# the same default prompt, the same seed and the same control, the front twin does not
# reproduce (painted 17.73% vs 17.38%, IoU 0.9040 vs 0.9088), and the parameters that
# made it are not in this repo. The Director ruled 2026-08-04 that this pair IS the
# character. It is not regenerable, so it is not an output — it is an input we happen
# to hold.
!canon/**

# Working dirs
state/
job_*/
renders*/
prep/
smart/
texpass/

__pycache__/
*.pyc
.venv/
venv/
.DS_Store
Thumbs.db
site/.astro/

# THE HERMETIC TEST FIXTURE IS AN INPUT, NOT AN OUTPUT (E18 D2, commissioned by
# E17 Ruling 3d). Same exception this file's own premise already makes for
# canon/: "large and regenerable" is measured false here in the half that
# matters — 40 KB total, and its whole purpose is that CI can run the write
# head's losslessness WITHOUT the recorded trees. A fixture the repo does not
# carry is a hermetic test that is not hermetic.
#
# Every rule above catches part of it: *.glb, *.png, *.npy by extension, and
# `state/`/`prep/` by directory name. A directory excluded by name is never
# descended into, so the negation has to re-include the tree itself, not only
# the files in it.
!tests/fixtures/**

# landing page + handbook build artifacts (site/.astro/ added by site-theme init)
site/dist/
site/node_modules/
.polyglot-cache.json
# the site's own images are tracked despite the *.png rule above
!site/src/assets/**

# python packaging artifacts (the extraction, 2026-08-08). `python -m build`
# and any editable install drop these into the tree; tools/facet_mcp.egg-info
# leaked into `git status` once before this rule existed.
dist/
build/
*.egg-info/
tools/*.egg-info/
.dist-check/
