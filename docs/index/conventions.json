{
  "schema": "record-index-conventions/1",
  "_note": "facet's declaration. Generated by introspection from tools/facet_index.py at the extraction, so every value is what the tool was running on rather than a transcription of it. Conventions are a FULL declaration: this file states what facet's documents mean, and record-index supplies no default for anything absent here.",
  "repo": {
    "name": "facet",
    "db_rel": "docs/index/facet.db",
    "db_env": "FACET_INDEX_DB"
  },
  "markers": [
    "CLAUDE.md",
    "docs/experiments"
  ],
  "corpora": {
    "experiments_dir": "docs/experiments",
    "record_roots": [
      "docs"
    ],
    "record_top_files": [
      "CLAUDE.md",
      "README.md"
    ],
    "law_files": [
      "CLAUDE.md"
    ],
    "prose_files": [
      "README.md",
      "docs/context-architecture.md",
      "docs/experiments/README.md",
      "docs/handbook/index.md",
      "docs/handbook/profiles.md",
      "docs/handbook/subjects.md",
      "docs/profiles-design.md",
      "docs/style-registers.md"
    ],
    "profile_files": [
      "profiles/beast.json",
      "profiles/character.json",
      "profiles/ship.json"
    ],
    "experiments_table": "docs/experiments/README.md",
    "sweep_extra_files": [
      "CHANGELOG.md",
      "SHIP_GATE.md",
      "SCORECARD.md",
      "SECURITY.md"
    ],
    "sweep_extra_dirs": [
      "site/src/content/docs"
    ]
  },
  "discovery": {
    "ruling_doc": "^E\\d\\d-.*ruling.*\\.md$",
    "kickoff_doc": "^E\\d\\d-.*kickoff.*\\.md$",
    "ruling_arc": {
      "strip_from": "ruling"
    },
    "kickoff_arc": {
      "leading": true
    },
    "experiment_prefix": "^(E\\d\\d)",
    "experiment_file": "^E\\d\\d[-.]",
    "spec_file_fragments": [
      "kickoff",
      "spec",
      "-E\\d",
      "-the-",
      "-cover-",
      "-paint-",
      "-cull-",
      "-atlas-",
      "-facial-",
      "-texture-",
      "-environment-",
      "-dense-",
      "-context-"
    ],
    "report_file_fragment": "report",
    "topical_ruling_files": [
      [
        "E01",
        "docs/experiments/E01-ruling-gate1.md"
      ],
      [
        "E02",
        "docs/experiments/E02-ruling-gate1.md"
      ],
      [
        "E06",
        "docs/experiments/E06-ruling-gate1.md"
      ],
      [
        "E07",
        "docs/experiments/E07-ruling-gate1.md"
      ],
      [
        "E08",
        "docs/experiments/E08-director-canon-ruling.md"
      ]
    ]
  },
  "headers": {
    "ruling": [
      "^## Ruling (\\d+)\\b(.*)$"
    ],
    "addenda": [
      "^## Post-ingest addenda\\s*(\\d*)\\b(.*)$"
    ],
    "amendment": [
      "^> ### (?:⚠\\s*)?Amendment (\\d+) \\((.*)$"
    ],
    "handoff": [
      "^## Session handoff\\s*(\\d*)\\s*\\((.*)$"
    ],
    "sub_ruling": "^\\*\\*(\\d+)([a-z])\\s+[—–-]",
    "sub_closure": "^\\*\\*(\\d+)([a-z])-([A-Z][A-Z-]+)\\b"
  },
  "vocabularies": {
    "verdicts": [
      "ACCEPTED",
      "REJECTED",
      "RATIFIED",
      "WITHDRAWN",
      "FALSIFIED",
      "CONFIRMED",
      "DESIGNATED",
